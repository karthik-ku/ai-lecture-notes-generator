# ==============================================================
# AI LECTURE NOTES GENERATOR - ENVIRONMENT CONFIGURATION
# ==============================================================

# Backend Server Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=prod

# Database Configuration (PostgreSQL for Production, H2 for Local Fallback)
# Local Docker Postgres: jdbc:postgresql://localhost:5432/ailecturedb
# Render / Railway Postgres URL example: jdbc:postgresql://ep-xyz.region.postgres.database.azure.com:5432/dbname?sslmode=require
DATABASE_URL=jdbc:postgresql://localhost:5432/ailecturedb
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_secure_password_here

# Frontend URL for CORS Security (Comma-separated origins allowed)
FRONTEND_URL=http://localhost:5173,http://localhost:3000

# Authentication Token Secret
JWT_SECRET=replace_with_a_secure_random_64_character_secret_key_for_production

# Optional AI API Configuration (OpenAI or any OpenAI-compatible provider)
# If left blank, the application automatically activates DEMO MODE (100% functional rule-based study materials)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Frontend Environment Variables (Vite)
# In production, set to your backend domain: e.g., https://your-backend.onrender.com/api
VITE_API_BASE_URL=/api
